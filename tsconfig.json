{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    // Vercel compiles each api/ function through a generated tsconfig in a temp
    // directory that extends this one. Relative paths in an extended config resolve
    // against the file they are written in, so naming the type root here is what lets
    // that build resolve @types/node instead of failing with TS2688.
    "typeRoots": ["./node_modules/@types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
